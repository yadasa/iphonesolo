{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$tabId": {
        ".write": "!newData.exists() || (newData.hasChildren(['clientId', 'tabId', 'seenAt']) && newData.getPriority() == null)",
        "clientId": {
          ".validate": "newData.isString() && newData.val().length <= 96"
        },
        "tabId": {
          ".validate": "newData.isString() && newData.val() == $tabId"
        },
        "seenAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 5000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
