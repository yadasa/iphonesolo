{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "target": "keiazotilt",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/deploy-version.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store,max-age=0"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/code-checkout",
        "function": {
          "functionId": "codeCheckout",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/code-verify",
        "function": {
          "functionId": "codeVerify",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/code-download",
        "function": {
          "functionId": "codeDownload",
          "region": "us-central1"
        }
      },
      {
        "source": "/code",
        "destination": "/code/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
